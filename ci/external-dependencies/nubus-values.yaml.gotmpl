global:
  secrets:
    generatePasswords: false

nubusProvisioning:
  nats:
    enabled: false
    bundled: false
    connection:
      host: "nats"
      port: "4222"

nubusUdmListener:
  nats:
    connection:
      host: "nats"

nubusUmcServer:
  smtp:
    auth:
      password: null

nubusKeycloakExtensions:
  smtp:
    connection:
      host: "maildev-smtp"
      port: "25"
      starttls: false
    auth:
      enabled: false

nubusStackDataUms:
  templateContext:
    # stack-data accepts no existing Secret for these three.
    svcPortalServerUserPassword: {{ derivePassword 1 "long" .Values.secrets.masterPassword "nubus" "svc-portal-server-password" | sha1sum | quote }}
    initialPasswordAdministrator: {{ derivePassword 1 "long" .Values.secrets.masterPassword "nubus" "administrator-password" | sha1sum | quote }}
    readonlyUserPassword: {{ derivePassword 1 "long" .Values.secrets.masterPassword "nubus" "readonly-user-password" | sha1sum | quote }}
  stackDataContext:
    smtpHost: maildev-smtp
    smtpPort: 25
    smtpUser: ""
    smtpStartTls: false
